# Zeitmaschine BBS configuration (sourced by start.sh)
BBS_NAME="Zeitmaschine BBS"
HTTP_PORT=8056
TELNET_PORT=2323
BIND=0.0.0.0
MAX_NODES=16
MAX_PER_IP=3
IDLE_MINUTES=15
SESSION_MINUTES=60
# Set to 1 only behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=0
# Gateway phonebook (default: ./phonebook.json)
#PHONEBOOK=/opt/zeitmaschine-bbs/phonebook.json
# Hotspot captive portal: unknown URLs redirect to the simulator (set by pi/setup-pi.sh)
CAPTIVE=0
